# Copy to .env and fill in. Never commit .env.

# Neo4j Aura (console.neo4j.io). Use neo4j+ssc:// only if a corporate proxy breaks TLS verification.
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<instance-id>
NEO4J_PASSWORD=<password>
NEO4J_DATABASE=<instance-id>

# LLM provider: ollama (default, local) | anthropic | openai (any OpenAI-compatible API, e.g. Groq)
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-oss-120b

# For LLM_PROVIDER=openai (example: Groq)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=<key>

# For LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=<key>

# For LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
